rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 個人利用(1人専用)前提の認証なし構成。
    // 書き込みは既知の6カテゴリ+決まった3フィールドに限定し、それ以外は拒否する。
    match /newsItems/{category} {
      allow read: if true;
      allow write: if category in ['ma', 'keiei', 'ai', 'kyodo', 'gunma', 'kyoyo']
                   && request.resource.data.keys().hasOnly(['label', 'items', 'fetchedAt']);
    }
  }
}
